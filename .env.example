# LLM provider - one of: anthropic | google | mistral | openai
LLM_PROVIDER=anthropic
# Optional model override; defaults per provider used if unset
LLM_MODEL=

ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Python service URL
PYTHON_SERVICE_URL=http://localhost:8001
